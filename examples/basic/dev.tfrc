# Use the locally built provider without publishing it to a registry:
#   export TF_CLI_CONFIG_FILE=$PWD/dev.tfrc
# Point this path at the directory containing terraform-provider-databricks-hacks.
provider_installation {
  dev_overrides {
    "mateuszboryn/databricks-hacks" = "<absolute-path-to-repository-root>"
  }
  direct {}
}
